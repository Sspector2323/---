# Скопируй значения в Railway → сервис → Variables. Файл .env в git НЕ коммитить.

# Обязательные
TELEGRAM_BOT_TOKEN=123456:ABC...           # токен от @BotFather (тот же, что в n8n)
OPENAI_API_KEY=sk-...                      # ключ OpenAI
GOOGLE_SERVICE_ACCOUNT_JSON=               # JSON сервисного аккаунта Google (целиком одной строкой или base64)
ADMIN_IDS=111111111,222222222              # Telegram ID админов через запятую (узнать: /myid в боте)

# Необязательные (по умолчанию — как в n8n)
SPREADSHEET_ID=16GFYOAe74YSPDDMLGPxvKjFS0d6heVbvs7VgUs_-Tnw
SHEET_GID=0
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=200
OPENAI_TEMPERATURE=0.7
MEMORY_WINDOW=5                            # сколько последних пар вопрос-ответ помнит ИИ
FOLLOWUP_DELAY=10                          # через сколько секунд слать «⚠️ ВАЖНО!»
PROMO_CHANNEL_ID=-1001407379425            # канал для рассылки «Стрим → в канал»
BROADCAST_DELAY=0.05                       # пауза между сообщениями рассылки, сек

# Автопересылка постов из канала Витуса в наш канал (PROMO_CHANNEL_ID)
SOURCE_CHANNEL=vtss2                       # юзернейм канала-источника без @ (или его числовой ID)
REPOST_MODE=auto                           # auto — сразу, approve — сначала спросить админов, off — выключить
