# ===== Мозг: openai или claude =====
AI_PROVIDER=openai

# --- OpenAI (если AI_PROVIDER=openai) ---
# Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# gpt-4.1 — умный; gpt-4.1-mini — дешевле и быстрее, но хуже справляется со сложными командами
OPENAI_MODEL=gpt-4.1

# --- Claude (если AI_PROVIDER=claude) ---
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
# low = быстрее и дешевле, medium/high = умнее, но дольше думает
JARVIS_EFFORT=low

# ===== Голос =====
# Слово, на которое он откликается (можно несколько через запятую)
WAKE_WORDS=джарвис,jarvis
# Голос edge-tts: ru-RU-DmitryNeural (мужской) / ru-RU-SvetlanaNeural (женский)
TTS_VOICE=ru-RU-DmitryNeural
# Как к вам обращаться
USER_NAME=сэр
CITY=Москва

# ===== Почта (IMAP/SMTP) =====
# Gmail: нужен «пароль приложения» https://myaccount.google.com/apppasswords
# Яндекс / Mail.ru: тоже пароль приложения в настройках безопасности
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Необязательно — для gmail/yandex/mail.ru/outlook определяются сами
IMAP_HOST=
SMTP_HOST=

# ===== Безопасность =====
# true = перед выключением ПК, отправкой писем, командами терминала и т.п. он спрашивает «Подтверждаете?»
CONFIRM_DANGEROUS=true

# ===== Дашборд =====
DASHBOARD_PORT=5050
