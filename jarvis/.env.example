# ===== Мозг =====
# claude_code — Claude Code на этом компьютере (по подписке Claude Pro/Max, без API-ключа)
# openai      — GPT по ключу OpenAI
# claude      — Claude по API-ключу
AI_PROVIDER=claude_code
# Для claude_code: пусто = модель по умолчанию; sonnet или haiku — быстрее отвечают
CLAUDE_CODE_MODEL=

# --- OpenAI (если AI_PROVIDER=openai) ---
# Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# gpt-4.1 — умный; gpt-4.1-mini — дешевле и быстрее, но хуже справляется со сложными командами
OPENAI_MODEL=gpt-4.1

# --- Claude (если AI_PROVIDER=claude) ---
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
# low = быстрее и дешевле, medium/high = умнее, но дольше думает
JARVIS_EFFORT=low

# ===== Голос =====
# Слово, на которое он откликается (можно несколько через запятую)
WAKE_WORDS=джарвис,jarvis
# Голос edge-tts: ru-RU-DmitryNeural (мужской) / ru-RU-SvetlanaNeural (женский)
TTS_VOICE=ru-RU-DmitryNeural
# Если основной голос не ответил — говорить запасным голосом Windows (обычно женский). false = только текст
OFFLINE_VOICE=true
# Как к вам обращаться
USER_NAME=сэр
CITY=Москва

# ===== Почта (IMAP/SMTP) =====
# Gmail: нужен «пароль приложения» https://myaccount.google.com/apppasswords
# Яндекс / Mail.ru: тоже пароль приложения в настройках безопасности
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Необязательно — для gmail/yandex/mail.ru/outlook определяются сами
IMAP_HOST=
SMTP_HOST=

# ===== Notion =====
# Секрет интеграции: https://www.notion.so/profile/integrations → New integration → Internal → скопировать секрет.
# Затем в Notion откройте «Сводка задач» и «J.A.R.V.I.S. — общий штаб» → ••• → Подключения → добавьте интеграцию.
NOTION_TOKEN=
NOTION_TASKS_DB=35e4ea9860c980be88d3f6d67aa0a4df
NOTION_HUB_PAGE=3e84ea9860c981a7a7c5deaf8aafd8f8

# ===== GitHub =====
# Токен: https://github.com/settings/personal-access-tokens/new → доступ ко всем репозиториям,
# права (Read): Contents, Pull requests, Issues, Actions, Metadata
GITHUB_TOKEN=
PROJECTS_DIR=
WORKSPACE_URLS=https://railway.com/dashboard,https://github.com,https://www.notion.so,https://claude.ai/code

# ===== Безопасность =====
# true = перед выключением ПК, отправкой писем, командами терминала и т.п. он спрашивает «Подтверждаете?»
CONFIRM_DANGEROUS=true

# ===== Дашборд =====
DASHBOARD_PORT=5050
